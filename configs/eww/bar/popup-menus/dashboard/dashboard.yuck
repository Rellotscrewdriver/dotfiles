(defwindow dash :namespace "dash" :monitor 0 :stacking "fg"
  :geometry (geometry :anchor "top left" :x "5px" :y "-4px" :width "20%" :height "900px")
  (box :space-evenly false :halign "start"
    (revealer :transition "slideright" :reveal dashrev :duration "350ms"
      (widget :uptime getUptime)
    )
  )
)

(defpoll getUptime :interval "1m" "uptime -p")

(defvar dashrev true)

(defwidget widget [uptime]
  (eventbox :space-evenly false :valign "start" :onhoverlost "./bar/popup-menus/scripts/toggleDashboard"
    (eventbox :class "shadowContainer" :onhoverlost "./scripts/scripts/toggleDashboard"
      (box :orientation "v" :space-evenly false
        (box :class "mainContainer" :orientation "v" :halign "center" :space-evenly false
          (box :class "profileContainer" :space-evenly false
            (box :class "profile" :space-evenly false :valign "start" :halign "start"
              (box :class "pfp")
              (box :class "pfp-text" :orientation "v" :space-evenly false
                (box :class "mUsername" :space-evenly false
                  (label :text "Welcome Rellot")
                )
                (box :class "upTime" :space-evenly false
                  (label :limit-width 25 :text "${uptime}")
                )
                (box :class "ctlPanel"
                  (eventbox :cursor "pointer" :onclick "systemctl poweroff" :class "shutdown" :tooltip " Shutdown "
                    (label :text "⏻")
                  )
                  (eventbox :cursor "pointer" :class "logout" :onclick "loginctl terminate-user $USER" :tooltip " Logout "
                    (label :text "")
                  )
                  (eventbox :cursor "pointer" :class "lockscr" :onclick "eww close dash && swaylock &" :tooltip " Lock "
                    (label :text "\\uf023")
                  )
                  (eventbox :cursor "pointer" :class "reboot" :onclick "systemctl reboot" :tooltip " Reboot "
                    (label :text "\\uf021")
                  )
                  (eventbox :cursor "pointer" :class "suspend" :onclick "systemctl suspend" :tooltip " Sleep "
                    (label :text "󰒲")
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
