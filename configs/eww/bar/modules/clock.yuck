(defpoll dt :interval "1m" "date +\"%-I:%M %p\"")

(defwidget clock [] 
	(box :space-evenly false :orientation "h"
    (eventbox :cursor "pointer" :onclick "./bar/popup-menus/scripts/toggleCal" (label :text "󰥔" :class "clkI"))
	  (eventbox :cursor "pointer" :onclick "./bar/popup-menus/scripts/toggleCal" 
      (label :text "${dt}" :class "clkT")
    )
  )
)
