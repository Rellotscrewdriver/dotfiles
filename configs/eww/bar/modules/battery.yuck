(deflisten batIcon `./bar/scripts/batIcon`)

(defwidget battery [] 
	(box :space-evenly false :orientation "h" :class "batT" :tooltip "Battery Left: ${EWW_BATTERY.BAT0.capacity}%" 
    (circular-progress :class "bat" :value {EWW_BATTERY.BAT0.capacity} :thickness 3 :start-at 25
      (box :class "batIco"
        (label :text "${batIcon}")
      )
    )
  )
)
