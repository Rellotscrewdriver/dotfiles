#!/bin/bash
# Function to fetch and output data as JSON
get_data() {
    # Fetch raw values
    device=$(bluetoothctl info | grep 'Alias:' | awk -F: '{print $2}' | xargs)
    devicePath=$(upower --dump | tr : _ | grep headset | awk 'FNR == 1' | awk '{print $2}')
    battery=$(upower -i "$devicePath" 2>/dev/null | grep percentage | awk '{print $2}')
    powered=$(bluetoothctl show | grep "Powered: yes" | wc -c)
    connected=$(bluetoothctl info | grep 'Device' | wc -c)

    # Logic for Icon
    if [ "$powered" -eq 0 ]; then
        icon="󰂲" # Bluetooth Off
        name="Bluetooth Off"
        batt="---"
    elif [ "$connected" -eq 0 ]; then
        icon="󰂯" # Bluetooth Idle
        name="Bluetooth Idle"
        batt="---"
    else
        icon="󰋋" # Connected (Headphones)
        name="${device}"
        batt="${battery:----}"
    fi

    # Output as single-line JSON
    jq -ncn \
        --arg icon "$icon" \
        --arg name "$name" \
        --arg batt "$batt" \
        '{"icon": $icon, "name": $name, "battery": $batt}'
}

# Initial update
get_data

# Listen for events and update
bluetoothctl --monitor | while read -r line; do
    # Only update on specific event triggers to save CPU
    if [[ "$line" == *"[DEL] Device"* || "$line" == *"[NEW] Device"* || "$line" == *"PropertiesChanged"* ]]; then
        get_data
    fi
done

