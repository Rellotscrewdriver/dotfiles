[General]
theme_name=Everblush
author=Rellot
comment=Everblush theme for Kvantum

[Common]
# Main Background (Everblush Dark)
window.color=#141b1e
# Lighter Background for inputs/lists
base.color=#232a2d
# Alternate row color for lists
alt.base.color=#232a2d

# Text Colors (Everblush White/Gray)
text.color=#dadada
disabled.text.color=#5c6a72
# Text color when highlighted
highlight.text.color=#141b1e

# Highlight/Accent Color (Everblush Blue)
highlight.color=#67b0e8

# Tooltips
tooltip.background.color=#141b1e
tooltip.text.color=#dadada

# Link Color (Everblush Red or Magenta)
link.color=#e57474
link.visited.color=#c47fd5

# Borders and Separators
frame.border.color=#232a2d
separator.color=#232a2d

[Hacks]
# These settings ensure the SVG is tinted correctly by the config colors
# If the base SVG is not monochromatic, these help force the color scheme.
transparent_dolphin_view=true
transparent_pcmanfm_view=true
transparent_ktitle_label=false

