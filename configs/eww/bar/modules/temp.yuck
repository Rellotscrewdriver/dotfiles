(deflisten cpuTemp "sh ./bar/scripts/temp.sh")

(defwidget temp []
  (box 
		:space-evenly false
		:orientation "h"
    :class "temp-t"
    (circular-progress :class "temp" :value {cpuTemp.tempNo} :thickness 3 :start-at 25
      (box :class "tempico"
       (label :text {cpuTemp.tempIcon})
      )
    )
  )
)
