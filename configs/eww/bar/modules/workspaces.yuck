(deflisten workspacesRaw :initial "[]" "~/.config/eww/bar/scripts/workspaces")

(defwidget workspaces []
  (box :class "workspaceSway" :orientation "h" :space-evenly true :halign "start" :spacing 10
    (for ws in workspacesRaw
      (button :onclick "swaymsg workspace ${ws.id}" :class "workspaceBtn ${ws.status}"
        ;; USE THE ICON HERE
        (label :text "${ws.icon}")
      )
    )
  )
)
