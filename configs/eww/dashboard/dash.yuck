;; **
;; ** Widgets config for EWW
;; ** Created by : @adi1090x
;; ** Converted by : @tripleo1
;; ** Edited by : Rellot

;; ** Variables ***********************************************************************

;; Profile vars
(defvar img "/home/Rellot/.config/eww/assets/pfp.png")
(defvar name "Rellot's Screwdriver")
(defpoll uName :interval "5h" `whoami`)
(defpoll host :interval "5h" `cat /etc/hostname`)
(deflisten info "./dashboard/scripts/pfpInfo")

;; Time vars
(defpoll year :interval "5s" `date +\"%Y\"`)
(defpoll day :interval "5s" `date +\"%d\"`)
(defpoll month :interval "5s" `date +\"%B\"`)
(defpoll weeks :interval "5s" `date +\"%A\"`)

;; Music vars
(defpoll musicCover :interval "2s" "./dashboard/scripts/musicInfo --cover")
(defpoll musicSong  :interval "1s" "./dashboard/scripts/musicInfo --song")
(defpoll musicArtist :interval "1s" "./dashboard/scripts/musicInfo --artist")
(defpoll musicStatus :interval "1s" "./dashboard/scripts/musicInfo --status")
(defpoll musicProgress :interval "500ms" "./dashboard/scripts/musicInfo --progress")

;; Uptime vars
(defpoll upHour :interval "5s" `uptime -p | awk '{print $2 \" \" $3}' | sed 's/,//g'`)
(defpoll upMin :interval "5s" `uptime -p | awk '{print $4 \" \" $5}'`)

;; Weather vars
(defpoll weather :interval "1h" `./dashboard/scripts/weather`)
(defvar weatherText "Weather Today")

;; Apps vars
(defpoll mails :interval "5m" `python ./dashboard/scripts/mails`)
(defpoll githubN :interval "10m" `sh ./dashboard/scripts/github`)

;; Files vars
(defpoll freeSpace :interval "5s" `df -h / | awk '{print $4}' | tail -n 1 | sed 's/G/GB/'`)

;; bluetooth var
(deflisten bluetooth :initial '{"icon": "󰂲", "name": "Bluetooth Off", "battery": "N/A"}' "./dashboard/scripts/bluetooth")

;; Audio/Light vars (Required for the slider widget)
(deflisten volume `./dashboard/scripts/volume`)
(deflisten micVol `./dashboard/scripts/mic`)
(deflisten brightness `./dashboard/scripts/brightness`)


;; ** Widgets *************************************************************************

;; background
(defwidget bg []
  (box :class "bg")
)

;; profile
(defwidget user []
  (box :class "genWin" :orientation "v" :spacing 35 :space-evenly false :vexpand false :hexpand false 
    (box :style "background-image: url('${img}');" :class "face" :halign "center")
    (label :class "fullName" :halign "center" :wrap true :limit-width 25 :text name)
    (box :class "pfpInfo" :orientation "v" :space-evenly false :vexpand false :hexpand false
      (label :class "dInfo1" :halign "start" :wrap true :limit-width 25 :text "󰀉  ${uName}@${host}")
      (label :class "dInfo2" :halign "start" :wrap true :limit-width 25 :text "󰣇  ${info.distro}")
      (label :class "dInfo3" :halign "start" :wrap true :limit-width 25 :text "󰌽  ${info.kern}")
      (label :class "dInfo4" :halign "start" :wrap true :limit-width 25 :text "  ${info.wm} ${info.wmver}")
    )
  )
)

;; clock
(defwidget date []
  (box :class "genWin" :orientation "h" :vexpand false :hexpand false :width 350
    (label :class "mDateIcon" :text "󰃭 ")
    (box :orientation "v" :vexpand false :hexpand false
      (label :class "mDate" :halign "start" :text "${weeks} ${day}")
      (label :class "mDate" :halign "start" :text "${month} ${year}")
    )
  )
)

;; archlinux
(defwidget arch []
  (box :class "arch" :vexpand false :hexpand false
    (button :class "iconWeb" :onclick "./dashboard/scripts/openLinks --arch" "󰣇")
  )
)

;; stackoverflow
(defwidget stacko []
  (box :class "stacko" :vexpand false :hexpand false
    (button :class "iconWeb" :onclick "./dashboard/scripts/openLinks --so" "")
  )
)

;; youtube
(defwidget youtube []
  (box :class "youtube" :vexpand false :hexpand false
    (button :class "iconWeb" :onclick "./dashboard/scripts/openLinks --yt" "")
  )
)

;; reddit
(defwidget reddit []
  (box :class "reddit" :vexpand false :hexpand false
    (button :class "iconWeb" :onclick "./dashboard/scripts/openLinks --rd" "󰑍")
  )
)

(defwidget udemy []
  (box :class "udemy" :vexpand false :hexpand false
    (button :class "iconWeb" :onclick "./dashboard/scripts/openLinks --ud" "")
  )
)


;; Music Player
(defwidget music []
  (box :class "genWin music" :orientation "h" :spacing 10 :space-evenly false
    ;; RIGHT: Information & Controls
    (image :class "musicCover" :path musicCover :image-width 200 :image-height 135)

    (box :orientation "v" :valign "center" :spacing 8 :space-evenly false :hexpand false
      (label :class "musicTitle"  :text musicSong :limit-width 26 :halign "start")
      (label :class "musicArtist" :text musicArtist :limit-width 25 :halign "start")
      
      (box :orientation "h" :halign "start" :spacing 25 :class "musicControls"
        (button :class "musicBtn" :onclick "./dashboard/scripts/musicInfo --prev" "󰒮")
        (button :class "musicBtnPlay" :onclick "./dashboard/scripts/musicInfo --toggle" musicStatus)
        (button :class "musicBtn" :onclick "./dashboard/scripts/musicInfo --next" "󰒭")
      )
    
    ;; The Progress Bar
      (box :class "musicBarContainer" :orientation "h" :space-evenly false
        (scale :class "musicBar" :min 0 :max 101 :round-digits 0 :active true :value musicProgress
               :onchange "./dashboard/scripts/musicInfo --set-progress {}")
      )
    )
  )
)

;; mail
(defwidget mail []
  (box :class "genWin"
    (box :orientation "h" :halign "center" :space-evenly false :vexpand false :hexpand false
      (box :class "notiBox" :space-evenly false :vexpand false :hexpand false
        (button :class "iconMail" :onclick "./dashboard/scripts/openLinks --mail" "󰊫")
        (button :class "notiLabel" :onclick "./dashboard/scripts/openLinks --mail"
          (label :class "notiLabel" :xalign 0 :text mails)
        )
      )
    )
  )
)

;; Github Notifications
(defwidget github []
  (box :class "genWin"
    (box :orientation "h" :halign "center" :space-evenly false :vexpand false :hexpand false
      (box :class "notiBox" :space-evenly false :vexpand false :hexpand false
        (button :class "iconGit" :onclick "./dashboard/scripts/openLinks --gh" "󰊤")
        (button :class "notiLabel" :onclick "./dashboard/scripts/openLinks --gh"
          (label :class "notiLabel" :xalign 0 :text githubN)
        )
      )
    )
  )
)

;; weather
(defwidget weather []
  (box :class "genWin"
    (box :orientation "v" :spacing 0 :space-evenly false :vexpand false :hexpand false
        (label :class "weatTemp" :halign "center" :xalign 0 :text "Weather Today")
        (label :class "weatStat" :halign "center" :wrap true :limit-width 30 :xalign 0 :text "${weather}")
    )
  )
)

;; apps
(defwidget apps []
  (box :class "genWin" :orientation "v" :space-evenly false :vexpand false :hexpand false
    (box :class "appBox" :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :style "background-image: url('./dashboard/images/icons/braveb.svg'); background-size: 48px;" :class "appDash" :onclick "./dashboard/scripts/openApps --br")
      (button :style "background-image: url('./dashboard/images/icons/discord.svg'); background-size: 56px;" :class "appDash" :onclick "./dashboard/scripts/openApps --dc")
      (button :style "background-image: url('./dashboard/images/icons/code.svg'); background-size: 56px;" :class "appDash" :onclick "./dashboard/scripts/openApps --cd")
    )
    (box :class "appBox" :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :style "background-image: url('./dashboard/images/icons/obsidian.svg'); background-size: 50px;" :class "appDash" :onclick "./dashboard/scripts/openApps --ob")
      (button :style "background-image: url('./dashboard/images/icons/godot.svg'); background-size: 56px;" :class "appDash" :onclick "./dashboard/scripts/openApps --gde")
      (button :style "background-image: url('./dashboard/images/icons/onlyoffice.svg'); background-size: 56px;" :class "appDash" :onclick "./dashboard/scripts/openApps --of")
    )
  )
)

(defwidget slider []
  (eventbox :valign "start"
    (box :class "genWin slidersCtl" :orientation "v" :space-evenly false
      (label :class "cpI" :text "Control Panel")

      ;; Mic Slider
      (box :class "micSlider" :space-evenly false :halign "center"
         (button :class "micIcon" :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle" "${micVol.icon}")
         (scale :value "${micVol.value}" :class "mic" :max 101 :min 0 :round-digits 0 :onchange "pactl set-source-volume @DEFAULT_SOURCE@ {}%")
      )
      ;; Volume Slider
      (box :class "volumeSlider" :space-evenly false :halign "center"
          (button :class "volIcon" :onclick "pamixer --toggle-mute" "${volume.icon}")
          (scale :class "vol" :value "${volume.value}" :max 101 :min 0 :round-digits 0 :onchange "pamixer --set-volume {}")
      )
      ;; Brightness Slider
      (box :class "lightSlider" :space-evenly false :halign "center"
          (label :class "ligIcon" :text "${brightness.icon}")
          (scale :value "${brightness.value}" :class "lig" :max 101 :min 1 :round-digits 0 :onchange "brightnessctl set {}%")
      )
    )
  )
)

;; bluetooth
(defwidget bluetooth []
  (box :class "genWin btBox" :orientation "v" :space-evenly false :vexpand false :hexpand false :valign "center" :halign "center"
    (button :valign "center" :class "btIcon" "${bluetooth.icon} ${bluetooth.battery}")
    (label :class "btName" :wrap true :limit-width 25 :text "${bluetooth.name}")
  )
)


;; folders
(defwidget folders []
  (box :class "cFold" :orientation "v" :space-evenly false :vexpand false :hexpand false
    (box :class "hddBox" :orientation "h" :space-evenly false :vexpand false :hexpand false
      (box :space-evenly false :vexpand false :hexpand false
        (button :class "hddIcon" :onclick "./dashboard/scripts/openApps --fm" "")
        (label :class "fsSep" :text "|"))
      (box :space-evenly false :vexpand false :hexpand false
        (label :class "hddLabel" :wrap true :limit-width 25 :text freeSpace)
      )
    )
    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder1" :onclick "./dashboard/scripts/openFolders --cfg" "")
      (button :class "labelFolder1" :onclick "./dashboard/scripts/openFolders --cfg" ".config")
    )

    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder2" :onclick "./dashboard/scripts/openFolders --home" "")
      (button :class "labelFolder2" :onclick "./dashboard/scripts/openFolders --home" "Home")
    )

    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder3" :onclick "./dashboard/scripts/openFolders --docs" "")
      (button :class "labelFolder3" :onclick "./dashboard/scripts/openFolders --docs" "Documents")
    )

    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder4" :onclick "./dashboard/scripts/openFolders --gitp" "")
      (button :class "labelFolder4" :onclick "./dashboard/scripts/openFolders --gitp" "Github Projects")
    )

    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder5" :onclick "./dashboard/scripts/openFolders --godotP" "")
      (button :class "labelFolder5" :onclick "./dashboard/scripts/openFolders --godotP" "Godot Projects")
    )

    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder6" :onclick "./dashboard/scripts/openFolders --notes" "")
      (button :class "labelFolder6" :onclick "./dashboard/scripts/openFolders --notes" "Programming Notes")
    )

    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder7" :onclick "./dashboard/scripts/openFolders --s" "")
      (button :class "labelFolder7" :onclick "./dashboard/scripts/openFolders --s" "Study Folder")
    )
      
    (box :orientation "h" :space-evenly false :vexpand false :hexpand false
      (button :class "iconFolder1" :onclick "./dashboard/scripts/openFolders --qt" "")
      (button :class "labelFolder1" :onclick "./dashboard/scripts/openFolders --qt" "QT Projects")
    )
  )
)

;; LAYOUTS
(defwidget uptime []
  (box :orientation "h" :spacing 15 :space-evenly true
    ;; Uptime Box
    (box :class "genWin" :orientation "h" :space-evenly false :spacing 20 :halign "center"
      (label :class "iconTimer" :text "")
      (box :orientation "v" :valign "center" 
        (label :class "upHour" :text upHour)
        (label :class "upMin" :text upMin)
      )
    )
  )
)

(defwidget socials []
  (box :class "socialBox" :orientation "h" :spacing 10 :space-evenly false :halign "center" 
      (arch)
      (stacko)
      (youtube)
      (reddit)
      (udemy)
  )
)

(defwidget layout []
  (box :class "bg" :orientation "h" :space-evenly false :spacing 10 :halign "center" :valign "center"
    ;; LEFT COLUMN
    (box :class "leftLay" :orientation "v" :spacing 10 :space-evenly false :width 335 :height 650 
        (user)
        (slider)
    )

    ;; MIDDLE COLUMN
    (box :class "midLay" :orientation "v" :spacing 10 :space-evenly false :width 675 :height 650
        (box :orientation "h" :spacing 10 :space-evenly true :width 775
          (weather)
          (date)
        )
        (box :orientation "h" :spacing 10 :space-evenly false
          (uptime)
          (apps)
          (box :orientation "v" :spacing 10 :space-evenly false
            (mail)
            (github)
          )
        )
        (box :orientation "h" :spacing 10 :space-evenly false :width 200 
          (box :width 450 (music))
          (box :width 215 (bluetooth))
        )
        (socials)
    )

    ;; RIGHT COLUMN
    (box :class "rightLay" :orientation "v" :spacing 10 :space-evenly false :width 420
        (folders)
    )
  )
)

(defwidget ImpLayout []
  (eventbox :onhoverlost "eww update mdashrev=false && eww close dashboard" :halign "center" :valign "center"
    (revealer :transition "slideup" :reveal mdashrev :duration "300ms"
      (box :space-evenly false
        (layout)
      )
    )
  )
)

;; do not make this camelCase cuz it broke the entire eww
(defvar mdashrev false)

;; ** SINGLE WINDOW DEFINITION **
(defwindow dashboard
  :geometry (geometry :x "0%" :y "0%" :width "0%" :height "0%" :anchor "center")
  :stacking "overlay"
  :exclusive false
  :windowtype "dialog"
  :wm-ignore false
  :focusable false
  :resizable false
  :monitor 0
  (ImpLayout)
)

