(deflisten network `./bar/scripts/network`)

(defwidget network [] 
	(box :space-evenly false :orientation "h"
    (eventbox :cursor "pointer" :onclick "exec foot impala &" :onrightclick "./bar/popup-menus/scripts/toggle-wifi.sh" 
      (label :text "${network.icon}" :class "netI")
    )
    (label :text "${network.name}" :class "netT")
  )
)
