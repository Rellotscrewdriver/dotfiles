(defwindow calender :namespace "calender" :monitor 0 :stacking "fg"
  :geometry (geometry :anchor "top right" :width "30%" :height "400px")
  (box :space-evenly false :halign "end"
    (revealer :transition "slideleft" :reveal calrev :duration "200ms"
      (calender)
    )
  )
)

(defvar calrev false)

(defpoll getDate :interval "1m" "date +'%d / %m / %Y, %A'")

(defpoll getTime :interval "1m" "date +%I:%M%p")

(defwidget calender []
  (eventbox :onhoverlost "./bar/popup-menus/scripts/toggleCal"
    (box :class "calContainer" :space-evenly false :orientation "v"
      (box :class "timeBox" :orientation "v" :halign "center" :space-evenly false
        (box :class "timeInner"
          (label :text "${getTime}")
        )
        (box :class "dateInner"
          (label :text "${getDate}")
        )
      )
      (box :class "calendarBox" :halign "center"
        (calendar :class "cal")
      )
    )
  )
)
